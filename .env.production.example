# Copy this file to .env.production on the DigitalOcean Droplet.
# Never commit .env.production.

# Container image built by .github/workflows/images.yml.
BETAROUTER_IMAGE=ghcr.io/lawrencettc/betarouter-ai-gateway-unified:latest
BETAROUTER_APP_VERSION=self-hosted
# Serialize direct Droplet builds so the monorepo fits on a 2 GB server.
BETAROUTER_BUILD_CONCURRENCY=1
BETAROUTER_BUILD_NODE_HEAP_MB=1536
# Set to never only when building the image directly on the Droplet.
BETAROUTER_PULL_POLICY=always

# Cloudflare remotely-managed tunnel token.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Embedded PostgreSQL. Use a long URL-safe value without quotes or spaces.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-url-safe-database-password
POSTGRES_DB=betarouter

# Required application secrets. Generate independent values with:
# openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
AUTH_SECRET=replace-with-auth-secret
GATEWAY_API_KEY_HASH_SECRET=replace-with-api-key-hash-secret
LLM_VIDEO_CONTENT_JWT_SECRET=replace-with-video-content-secret

# Platform provider credential encryption. Generate two independent values with:
# openssl rand -base64 32
# Keep old PLATFORM_PROVIDER_ENCRYPTION_KEYS entries during key rotation so
# credentials encrypted with earlier versions remain decryptable.
PLATFORM_PROVIDER_ENCRYPTION_KEYS=v1:replace-with-32-byte-base64-key
PLATFORM_PROVIDER_ENCRYPTION_CURRENT_VERSION=v1
PLATFORM_PROVIDER_FINGERPRINT_KEY=replace-with-independent-32-byte-base64-key

# Comma-separated accounts allowed to use the enterprise admin console.
ADMIN_EMAILS=replace-with-admin-email
# Immutable user IDs allowed to manage and reveal shared platform credentials.
# Look up the existing verified admin account ID after its first sign-in.
PLATFORM_ADMIN_USER_IDS=replace-with-admin-user-id

# Public hostnames managed by Cloudflare.
UI_URL=https://betarouter.com
APP_URL=https://betarouter.com
GATEWAY_URL=https://api.betarouter.com/v1
PLAYGROUND_URL=https://chat.betarouter.com
CODE_URL=https://betapass.betarouter.com
DOCS_URL=https://docs.betarouter.com
ADMIN_URL=https://admin.betarouter.com
API_URL=https://platform-api.betarouter.com
API_BACKEND_URL=http://localhost:4002
ORIGIN_URLS=https://betarouter.com,https://chat.betarouter.com,https://playground.betarouter.com,https://betapass.betarouter.com,https://code.betarouter.com,https://admin.betarouter.com,https://platform-api.betarouter.com
COOKIE_DOMAIN=.betarouter.com
PASSKEY_RP_ID=betarouter.com
PASSKEY_RP_NAME=BetaRouter

# Legacy/fallback provider credentials. Platform-managed keys can instead be
# added in Admin → Platform Providers after deployment.
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GOOGLE_AI_STUDIO_API_KEY=

# Optional sign-in providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hosted authentication and email. The managed Compose file also pins HOSTED so
# the self-hosted sign-in hook cannot automatically verify new accounts.
HOSTED=true
# Use a full-access Resend key because hosted auth also manages Contacts. Verify
# betarouter.com in Resend before deploying these settings.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_AUDIENCE_ID=replace-with-resend-audience-id
RESEND_NEWSLETTER_TOPIC_ID=replace-with-resend-newsletter-topic-id
RESEND_FROM_EMAIL="betarouter <hello@betarouter.com>"
RESEND_REPLY_TO_EMAIL=contact@betarouter.com

# Optional analytics integration.
POSTHOG_KEY=
POSTHOG_HOST=
# Hosted billing. Use live-mode values from the same Stripe account.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_DEV_PLAN_LITE_PRICE_ID=
STRIPE_DEV_PLAN_PRO_PRICE_ID=
STRIPE_DEV_PLAN_MAX_PRICE_ID=
STRIPE_CHAT_PLAN_STARTER_PRICE_ID=
STRIPE_CHAT_PLAN_PLUS_PRICE_ID=
STRIPE_CHAT_PLAN_PRO_PRICE_ID=
STRIPE_PROVIDER_LISTING_PRICE_ID=

# Keep upstream telemetry disabled unless explicitly desired.
TELEMETRY_ACTIVE=false
