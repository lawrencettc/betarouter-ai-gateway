{
	"name": "@betarouter/db",
	"version": "0.0.0",
	"private": true,
	"license": "SEE LICENSE IN ../../LICENSE",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./db": {
			"types": "./dist/db.d.ts",
			"import": "./dist/db.js"
		},
		"./orm": {
			"types": "./dist/orm.d.ts",
			"import": "./dist/orm.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		}
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsc && resolve-tspaths",
		"dev": "tsc-watch --onSuccess 'resolve-tspaths'",
		"format": "eslint --fix . && prettier --write .",
		"lint": "eslint . && prettier --check .",
		"migrate": "pnpm drizzle-kit migrate --config drizzle.config.ts",
		"migrations": "pnpm drizzle-kit generate --config drizzle.config.ts",
		"push": "pnpm drizzle-kit push --force --config drizzle.config.ts",
		"seed": "node dist/seed.js"
	},
	"dependencies": {
		"@betarouter/cache": "workspace:*",
		"@betarouter/logger": "workspace:*",
		"@betarouter/models": "workspace:*",
		"@betarouter/shared": "workspace:*",
		"@kubiks/otel-drizzle": "2.0.3",
		"@opentelemetry/api": "1.9.0",
		"drizzle-orm": "1.0.0-beta.1",
		"nanoid": "5.1.5",
		"pg": "^8.16.3",
		"zod": "3.25.75"
	},
	"devDependencies": {
		"@types/pg": "^8.15.5",
		"drizzle-kit": "1.0.0-beta.1",
		"ioredis": "5.7.0"
	}
}
